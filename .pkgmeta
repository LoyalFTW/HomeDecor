package-as: HomeDecor

enable-nolib-creation: no

externals:
  Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  Libs/HereBeDragons: https://repos.wowace.com/wow/herebedragons
  Libs/Krowi_WorldMapButtons: https://github.com/TheKrowi/Krowi_WorldMapButtons.git
  Libs/Foundry: https://github.com/Royaleint/Foundry.git

ignore:
  - .github
  - .gitignore
  - README.md
  - .pkgmeta

move-folders:
  HomeDecor/HomeDecor: HomeDecor
  HomeDecor/HomeDecor_Data_Vendors: HomeDecor_Data_Vendors
  HomeDecor/HomeDecor_Data_Drops: HomeDecor_Data_Drops
  HomeDecor/HomeDecor_Data_Events: HomeDecor_Data_Events
  HomeDecor/HomeDecor_Data_Professions: HomeDecor_Data_Professions
  HomeDecor/HomeDecor_Data_Trainers: HomeDecor_Data_Trainers
